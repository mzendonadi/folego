# Copie para deploy/.env (o setup-server.sh gera os valores sozinho). NUNCA versionar o .env real.
POSTGRES_PASSWORD=troque-por-hex-aleatorio
APP_SECRET=troque-por-base64-aleatorio-com-48-bytes

# --- Pagamento -------------------------------------------------------------
# Teste do servidor (nenhum Pix é real):
PAYMENT_PROVIDER=fake
ALLOW_FAKE_GATEWAY_IN_PRODUCTION=1
WEBHOOK_SECRET=troque-por-hex-aleatorio

# Produção com Asaas: troque as duas linhas acima por PAYMENT_PROVIDER=asaas e apague ALLOW_FAKE_...,
# depois preencha as quatro abaixo. ATENÇÃO: a chave do Asaas COMEÇA COM "$". Use ASPAS SIMPLES, senão o
# Docker interpreta o "$" como variável e corrompe a chave sem avisar.
# ASAAS_API_KEY='$aact_...'
# ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3     # sandbox; em produção: https://api.asaas.com/v3
# ASAAS_PIX_KEY=chave-pix-aleatoria-cadastrada-no-asaas
# ASAAS_WEBHOOK_TOKEN=token-com-32-ou-mais-caracteres   # o mesmo cadastrado no webhook do Asaas (NÃO é a chave da API)

# --- IA dos roteiros (opcional) ----------------------------------------------
# Sem chave, os roteiros saem dos modelos deterministicos (o cliente recebe o conteudo do mesmo jeito).
# Com chave, a IA (Claude) escreve os roteiros; um verificador rejeita qualquer valor, porcentagem ou lei
# que ela invente e, se reprovar ou falhar, cai no modelo. A IA so recebe valores e categorias (nunca nomes).
# ANTHROPIC_API_KEY=sk-ant-...
# ADMIN_EMAILS=voce@exemplo.com   (quem pode entrar no backoffice /gestao como dono, por código enviado ao e-mail)
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   (obrigatório se a chave foi criada sem workspace; o ID não é segredo)
# AI_MODEL=claude-sonnet-5
# AI_MAX_CALLS_PER_DAY=200

# --- E-mail transacional (opcional) --------------------------------------------
# Serve para mandar o link de acesso ao cliente (e, depois, o código de login da assinatura).
# Crie a conta no Resend (resend.com), verifique o dominio folego.online (o Resend mostra os registros SPF/DKIM
# para voce cadastrar no Cloudflare) e cole a chave. O endereco de e-mail do cliente nao e guardado.
# Anti-robô (Cloudflare Turnstile): crie o widget em dash.cloudflare.com > Turnstile (domínio folego.online) e cole as DUAS chaves.
# TURNSTILE_SITE_KEY=0x4AAAA...   (pública)
# TURNSTILE_SECRET=0x4AAAA...     (segredo: só aqui)
# Indexação do site: 0 = fechado (noindex, pré-lançamento); 1 = aberto aos buscadores (só no lançamento, com o Asaas real ligado).
# SEO_OPEN=0
# RESEND_API_KEY=re_...
# EMAIL_FROM=Fôlego <acesso@folego.online>

# --- Recursos que exigem revisao juridica (deixe desligados ate la) ---------------
# Propostas de parceiros (consignado etc.): LGPD e Lei do Superendividamento.
# LEADS_ENABLED=1
# Assinaturas mensais (precisam de e-mail configurado):
# SUBSCRIPTIONS_ENABLED=1
# Token do administrador para cadastrar parceiros (32+ caracteres).
# PARTNER_ADMIN_TOKEN=
# Só em desenvolvimento local: devolve o código de login na resposta da API (NUNCA em produção).
# EXPOSE_DEV_CODES=1
