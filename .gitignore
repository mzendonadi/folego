apps/web/assets/vendor/
apps/web/assets/fonts/
apps/web/scripts/build-dist2.mjs
deploy/site/
deploy/nginx/cloudflare-ips.conf

# Pacotes de deploy e logs
*.tgz
*.log

# Sistema
.DS_Store
Thumbs.db

# Ambiente local de testes (banco de arquivo e dados de exemplo)
.local-data/
